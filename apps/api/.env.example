# Neon connection string (use the pooled "-pooler" host for the API).
DATABASE_URL=postgresql://user:password@ep-example-pooler.ap-southeast-1.aws.neon.tech/territory_radar?sslmode=require

# ── Places Data Source ──────────────────────────────────────────────────────
# Option 1: Google Places API (New)
GOOGLE_PLACES_API_KEY=
# Option 2: OpenStreetMap Overpass API (free public data, no API key required)
# If GOOGLE_PLACES_API_KEY is unset, it automatically defaults to 'osm'.
PLACES_PROVIDER=osm
# Optional custom Overpass endpoint:
# OVERPASS_API_URL=https://overpass-api.de/api/interpreter


# ── AI Review Mining (provide either Anthropic OR Gemini) ───────────────────
# Option 1: Anthropic Claude (default model: claude-sonnet-4-6)
ANTHROPIC_API_KEY=
# Option 2: Google Gemini (default model: gemini-2.5-flash)
GEMINI_API_KEY=

# Optional: explicit provider ('anthropic' | 'gemini'). Auto-detected if omitted.
# AI_PROVIDER=gemini
# Optional: explicit model override
# AI_MODEL=gemini-2.5-flash


# Shared secret clients send as the `x-api-key` header. At least 32 characters.
API_KEY=

# Places API spend cap in USD per calendar month (estimated from call counts).
PLACES_MONTHLY_BUDGET=200

# Percentage of active places re-enriched (Place Details) per daily run.
ENRICH_ROTATION_PCT=15

# true = no outbound Google or Anthropic calls; scheduled jobs are skipped.
KILL_SWITCH=false

PORT=3000

# ── Queue & rate limiting ───────────────────────────────────────────────────
# pg-boss connection. Leave unset to reuse DATABASE_URL. On Neon, the DIRECT
# (non "-pooler") host is the better choice for the queue's polling sessions.
# QUEUE_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/territory_radar?sslmode=require

# Parallel workers per queue.
SCAN_CONCURRENCY=4

# Ceiling on Google calls per second across all workers.
PLACES_MAX_QPS=8
